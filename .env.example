# Formspree form ID for the /inquiry page. Create a form at https://formspree.io and paste its ID here.
NEXT_PUBLIC_FORMSPREE_FORM_ID=

# Optional: canonical site URL (used in sitemap and structured data)
# NEXT_PUBLIC_SITE_URL=https://sproutflow-studio.com

# Vercel Blob store for images. Images were removed from the repo in 323be5b and
# are served from Blob. Without this, every image 404s in local dev.
NEXT_PUBLIC_BLOB_STORE_URL=https://kektfntppap5yky4.public.blob.vercel-storage.com

# Optional: Cal.com link for the /book page (e.g. sproutflow/15min or a full
# https://cal.com/... URL). Unset = booking CTAs point at /inquiry and /book
# redirects there. Inlined at build time, so rebuild after changing it.
# NEXT_PUBLIC_CAL_LINK=
