# Formspree form for the /inquiry page.
# Optional: override the Formspree form ID. Unset or blank = DEFAULT_FORMSPREE_FORM_ID in lib/constants.ts.
# NEXT_PUBLIC_FORMSPREE_FORM_ID=

# Optional: canonical site URL for metadataBase, canonicals, sitemap, robots.txt,
# and structured data (lib/site.ts). Unset = https://www.sproutflow-studio.com,
# the serving host; the apex 307s to www. Trailing slashes are stripped.
# NEXT_PUBLIC_SITE_URL=https://www.sproutflow-studio.com

# Vercel Blob store for images. Images were removed from the repo in 323be5b and
# are served from Blob. Without this, every image 404s in local dev.
NEXT_PUBLIC_BLOB_STORE_URL=https://kektfntppap5yky4.public.blob.vercel-storage.com

# Optional: override the Cal.com link for the /book page (e.g. sproutflow/15min
# or a full https://cal.com/... URL). Unset = the default in lib/constants.ts.
# Set to "off" to send booking CTAs to /inquiry and redirect /book there.
# Inlined at build time, so rebuild after changing it.
# NEXT_PUBLIC_CAL_LINK=
